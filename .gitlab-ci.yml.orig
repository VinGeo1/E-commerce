stages:
  - validate
  - build
  - deploy
  - destroy

variables:
  AWS_DEFAULT_REGION: us-east-1
  ECR_REGISTRY: "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"
  BACKEND_REPO: ecommerce-backend
  FRONTEND_REPO: ecommerce-frontend
  BACKEND_IMAGE: "${ECR_REGISTRY}/${BACKEND_REPO}:${CI_COMMIT_SHA}"
  FRONTEND_IMAGE: "${ECR_REGISTRY}/${FRONTEND_REPO}:${CI_COMMIT_SHA}"
  ECS_CLUSTER: ecommerce-cluster
  ECS_SERVICE_BACKEND: backend-service
  ECS_SERVICE_FRONTEND: frontend-service
  DOCKER_HOST: tcp://docker:2376
  DOCKER_TLS_CERTDIR: "/certs"
  DOCKER_TLS_VERIFY: "1"
  DOCKER_CERT_PATH: "/certs/client"

validate:
  stage: validate
  image: alpine:3.20
  script:
    - |
      if [ -z "$AWS_ACCESS_KEY_ID" ]; then echo "MISSING: AWS_ACCESS_KEY_ID"; exit 1; fi
      if [ -z "$AWS_SECRET_ACCESS_KEY" ]; then echo "MISSING: AWS_SECRET_ACCESS_KEY"; exit 1; fi
      if [ -z "$AWS_DEFAULT_REGION" ]; then echo "MISSING: AWS_DEFAULT_REGION"; exit 1; fi
      if [ -z "$AWS_ACCOUNT_ID" ]; then echo "MISSING: AWS_ACCOUNT_ID"; exit 1; fi
      if [ -z "$ALB_DNS" ]; then echo "MISSING: ALB_DNS"; exit 1; fi
      echo "All required CI variables present."
  rules:
    - if: '$CI_COMMIT_BRANCH == "main"'

.dind:
  image: docker:24.0.5
  services:
    - name: docker:24.0.5-dind
      command: ["--tls=false"]

build-backend:
  extends: .dind
  stage: build
  before_script:
    - apk add --no-cache aws-cli
    - aws ecr get-login-password --region "$AWS_DEFAULT_REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"
  script:
    - docker build -t "$BACKEND_IMAGE" -t "${ECR_REGISTRY}/${BACKEND_REPO}:latest" backend/
    - docker push "$BACKEND_IMAGE"
    - docker push "${ECR_REGISTRY}/${BACKEND_REPO}:latest"
  rules:
    - if: '$CI_COMMIT_BRANCH == "main"'

build-frontend:
  extends: .dind
  stage: build
  before_script:
    - apk add --no-cache aws-cli
    - aws ecr get-login-password --region "$AWS_DEFAULT_REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"
  script:
    - docker build -t "$FRONTEND_IMAGE" -t "${ECR_REGISTRY}/${FRONTEND_REPO}:latest" frontend/
    - docker push "$FRONTEND_IMAGE"
    - docker push "${ECR_REGISTRY}/${FRONTEND_REPO}:latest"
  rules:
    - if: '$CI_COMMIT_BRANCH == "main"'

.ecs-deploy:
  stage: deploy
  image:
    name: amazon/aws-cli:latest
    entrypoint: [""]
  before_script:
    - command -v jq >/dev/null 2>&1 || yum install -y jq >/dev/null 2>&1
  script:
    - sh scripts/ecs-deploy.sh

deploy-backend:
  extends: .ecs-deploy
  variables:
    ECS_SERVICE: backend-service
    IMAGE: "${ECR_REGISTRY}/${BACKEND_REPO}:${CI_COMMIT_SHA}"
  needs:
    - build-backend
  environment:
    name: production
    url: "http://${ALB_DNS}"
  rules:
    - if: '$CI_COMMIT_BRANCH == "main"'

deploy-frontend:
  extends: .ecs-deploy
  variables:
    ECS_SERVICE: frontend-service
    IMAGE: "${ECR_REGISTRY}/${FRONTEND_REPO}:${CI_COMMIT_SHA}"
  needs:
    - build-frontend
  environment:
    name: production
    url: "http://${ALB_DNS}"
  rules:
    - if: '$CI_COMMIT_BRANCH == "main"'

destroy:
  stage: destroy
  image:
    name: hashicorp/terraform:latest
    entrypoint: [""]
  variables:
    TF_VAR_db_password: "${DB_PASSWORD}"
    TF_VAR_backend_image: "${ECR_REGISTRY}/${BACKEND_REPO}:latest"
    TF_VAR_frontend_image: "${ECR_REGISTRY}/${FRONTEND_REPO}:latest"
  before_script:
    - cd infrastructure
    - terraform init -input=false
  script:
    - echo "DESTROYING ALL TERRAFORM-MANAGED INFRASTRUCTURE"
    - terraform destroy -input=false -auto-approve
  rules:
    - if: '$CI_COMMIT_BRANCH == "main"'
      when: manual
      allow_failure: false